# ==========================================
# Hermes Virtual Office — Configuration
# ==========================================
# Copy to .env.local and fill in. Every variable below is actually read by the
# code; see docs/ARCHITECTURE.md for what each one drives.

# ---- Hermes connection -------------------------------------------------------
# Path to the `hermes` executable. REQUIRED: the Kanban board is driven through
# the official CLI (`hermes kanban ... --json`), not by reading kanban.db.
HERMES_BIN=/usr/local/bin/hermes
# Optional: pin one board. Omit to use the CLI's active board.
# HERMES_KANBAN_BOARD=default
# Optional: abort a CLI call after N ms (default 20000).
# KANBAN_TIMEOUT_MS=20000

# ---- LLM provider (meetings only) -------------------------------------------
# Without these the 3D office still runs; starting a meeting returns a clear
# "not configured" error instead. Any OpenAI-compatible chat endpoint works.
#
# `configured` is Boolean(AI_BASE_URL && AI_API_KEY) — an empty value means the
# Meeting panel shows "LLM belum dikonfigurasi" and refuses to start.
# On a machine that already runs Hermes, the fastest correct source is a provider
# from ~/.hermes/config.yaml `custom_providers` (base_url + its api_key):
#   AI_BASE_URL=http://localhost:20128/v1
#   AI_API_KEY=<the provider's key>
#   AI_MODEL=<a model id that provider serves>
# The office's model pickers read that same config, so the two stay in sync.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Meeting shape and resilience
MAX_MEETING_TURNS=10
DEFAULT_MEETING_ROUNDS=2
# Upstream gateways intermittently answer 503; turns are retried.
MEETING_TURN_TIMEOUT_MS=120000
MEETING_TURN_RETRIES=3
MEETING_TURN_BACKOFF_MS=4000

# ---- Storage -----------------------------------------------------------------
# Meeting transcripts and minutes (markdown).
DATA_DIR=./data

# ---- Frontend ----------------------------------------------------------------
# How often the board re-polls Hermes, in ms (default 4000).
# NEXT_PUBLIC_POLL_MS=4000

# ---- Development only --------------------------------------------------------
# Exposes window.__office for end-to-end probes. Off unless set to 1.
# NEXT_PUBLIC_E2E_HOOK=1

# ---- Chat -------------------------------------------------------------------
# Chat talks to an agent as that agent's OWN profile: `jun` the agent runs the `jun`
# profile and its memory lives in that profile's session store. There is no separate
# chat profile to configure — an agent and a profile are the same thing.
#
# A profile created with `hermes profile create <name> --no-skills` (which is what
# the office's "+ Agent" button does) has a 2 KB config. The install's own `default`
# profile may carry a very large system_prompt in its config.yaml, which is sent on
# every message, so chatting with `default` is slower and costlier than with a
# purpose-made agent.

# How long one chat turn may take. An agent may run tools before answering.
# CHAT_TIMEOUT_MS=180000

# Hosts (beyond localhost) allowed to WRITE — kill/spawn agents, create tasks,
# send chat, start meetings. Comma-separated `host[:port]`; a scheme prefix is
# tolerated. The app is usually opened at a public address, and the write guard
# refuses any origin it does not recognise, so this must list that address or
# every button that changes something returns 403.
# ALLOWED_ORIGINS=203.0.113.10:3300,office.example.com
