# ==========================================
# Hermes Virtual Office — Configuration
# ==========================================

# Port to bind
PORT=3000
NODE_ENV=development

# Hermes Connection Mode: 'api' (standard) or 'mock' (offline preview/demo)
HERMES_DRIVER=api

# Hermes Agent API Server Configuration
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=your_hermes_api_key_here

# Path to the hermes executable (required — the board is driven via its CLI)
HERMES_BIN=/usr/local/bin/hermes
# Optional: pin a specific board slug
# HERMES_KANBAN_BOARD=default

# LLM Provider for Meeting & Chat Simulation
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_custom_key_here
AI_MODEL=gpt-4o-mini

# Meeting Configuration
MAX_MEETING_TURNS=10
DEFAULT_MEETING_ROUNDS=2

# Data Directory for Transcripts & Minutes
DATA_DIR=./data
